---
const email = 'bruno.becchetti@gmail.com';
// À remplacer par le lien d'un formulaire (Tally, Google Forms…) quand il existera
const avisHref = `mailto:${email}?subject=${encodeURIComponent('Mon avis sur la formation')}`;
---

<section id="contact" class="section section--sage">
  <div class="wrap contact">
    <h2>Parlons de votre projet</h2>
    <p>Un besoin de formation, d’accompagnement ou de conseil ? Écrivez-moi, je vous réponds rapidement.</p>
    <p>J’interviens partout en France, en présentiel dans vos locaux ou à distance.</p>
    <a href={`mailto:${email}`} class="contact__email">{email}</a>
    <p class="contact__alt">
      ou retrouvez-moi sur <a href="https://www.linkedin.com/in/bruno-becchetti-08199333/" rel="noopener">LinkedIn</a>
    </p>
    <p class="contact__avis">
      Vous avez suivi une de mes formations ? <a href={avisHref}>Laissez-moi votre avis</a>
    </p>
  </div>
</section>

<style>
  .contact { text-align: center; }
  .contact p { color: var(--slate); }
  .contact__email {
    display: inline-block;
    margin-block: 1rem 1.5rem;
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--step-3);
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .contact__email:hover { color: var(--savanna-text); }
  .contact__alt { font-size: var(--step--1); }
  .contact__avis {
    margin: 2.5rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(30 43 48 / 0.12);
    max-width: 32rem;
    font-size: var(--step--1);
  }
</style>
