---
import { Image } from "astro:assets";
import elephants from "../assets/images/elephants-bw.jpg";
---

<section class="hero">
  <Image
    src={elephants}
    alt=""
    class="hero__bg"
    widths={[800, 1400, 2000]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero__veil" aria-hidden="true"></div>
  <div class="wrap hero__content">
    <h1>Formations et conseil en organisation et méthodes</h1>
    <p class="hero__proverb">
      <span>Seul, on va plus vite…</span>
      <span>…ensemble, on va plus loin.</span>
    </p>
    <a href="#contact" class="hero__cta">Me contacter</a>
  </div>
  <blockquote class="quote">
    <p>
      « Tu me dis, j’oublie. Tu m’apprends, je me souviens. Tu m’impliques,
      j’apprends. »
    </p>
    <cite>Benjamin Franklin</cite>
  </blockquote>
</section>

<style>
  .hero {
    position: relative;
    /* tout l'écran visible, moins la barre de navigation (~4rem) */
    min-height: calc(100svh - 4rem);
    display: grid;
    align-items: center;
    color: var(--ink);
    background: var(--paper);
    overflow: hidden;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
  }
  /* grand écran : l'image ne s'étire plus au-delà de 75rem et ses bords se fondent dans le blanc */
  @media (min-width: 75rem) {
    .hero__bg {
      left: 50%;
      width: 75rem;
      transform: translateX(-50%);
      mask-image: linear-gradient(
        to right,
        transparent,
        #000 15%,
        #000 85%,
        transparent
      );
    }
  }
  /* voile blanc derrière le texte : garde le titre lisible devant les zones sombres de la photo */
  .hero__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgb(255 255 255 / 0.75) 0%,
      rgb(255 255 255 / 0.6) 45%,
      transparent 80%
    );
  }
  @media (max-width: 48rem) {
    .hero__veil {
      background: rgb(255 255 255 / 0.55);
    }
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    z-index: 1;
    height: 10rem;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0.9), transparent);
  }
  .hero::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 10rem;
    background: linear-gradient(to top, rgb(255 255 255 / 0.9), transparent);
  }
  .hero__content {
    position: relative;
    z-index: 1;
    padding-block: 4rem 12rem;
  }
  h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 600;
    line-height: 1.15;
    max-width: 22ch;
    color: var(--savanna-text);
    margin-bottom: 3rem;
    padding-left: 1rem;
    border-left: 3px solid var(--savanna);
  }
  .hero__proverb {
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--step-2);
    line-height: 1.2;
    margin-bottom: 2rem;
  }
  .hero__proverb span {
    display: block;
  }
  .hero__proverb span + span {
    padding-left: 5em;
    margin-top: 0.4em;
  }
  .hero__cta {
    display: inline-block;
    padding: 0.8em 1.4em;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
    text-decoration: none;
  }
  .hero__cta:hover {
    background: var(--slate);
  }

  .quote {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.5rem;
    z-index: 1;
    margin: 0;
    padding-inline: var(--gutter);
    text-align: center;
  }
  .quote p {
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--step-0);
    line-height: 1.35;
    margin: 0 auto 0.25rem;
  }
  .quote cite {
    font-style: normal;
    font-size: var(--step--1);
  }
</style>
