---
import { Image } from "astro:assets";
import elephants from "../assets/images/elephants.jpg";
---

<section class="hero">
  <Image
    src={elephants}
    alt=""
    class="hero__bg"
    widths={[800, 1400, 2000]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="wrap hero__content">
    <h1>Formations et conseil en organisation et méthodes</h1>
    <p class="hero__proverb">
      <span>Seul, on va plus vite…</span>
      <span>…ensemble, on va plus loin.</span>
    </p>
    <a href="#contact" class="hero__cta">Me contacter</a>
  </div>
</section>

<blockquote class="wrap quote">
  <p>
    « Tu me dis, j’oublie. Tu m’apprends, je me souviens. Tu m’impliques,
    j’apprends. »
  </p>
  <cite>Benjamin Franklin</cite>
</blockquote>

<style>
  .hero {
    position: relative;
    min-height: min(88vh, 48rem);
    display: grid;
    align-items: end;
    color: var(--paper);
    overflow: hidden;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(30 43 48 / 0.85) 0%,
      rgb(30 43 48 / 0.25) 60%,
      transparent
    );
  }
  .hero__content {
    position: relative;
    z-index: 1;
    padding-block: 4rem;
  }
  h1 {
    font-size: var(--step-1);
    font-weight: 500;
    max-width: 30ch;
    margin-bottom: 1.5rem;
    padding-left: 1rem;
    border-left: 3px solid var(--savanna);
  }
  .hero__proverb {
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--step-4);
    line-height: 1.05;
    margin-bottom: 2rem;
  }
  .hero__proverb span {
    display: block;
  }
  .hero__proverb span + span {
    padding-left: 1.5em;
  }
  .hero__cta {
    display: inline-block;
    padding: 0.8em 1.4em;
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }
  .hero__cta:hover {
    background: var(--mist);
  }

  .quote {
    padding-block: var(--section) 0;
    margin-block: 0;
    text-align: center;
  }
  .quote p {
    font-family: var(--serif);
    font-size: var(--step-2);
    line-height: 1.35;
    max-width: 38ch;
    margin-inline: auto;
  }
  .quote cite {
    font-style: normal;
    color: var(--slate);
    font-size: var(--step--1);
  }
</style>
